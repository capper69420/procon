# Supabase (optional — system works offline without these)
SUPABASE_URL=
SUPABASE_KEY=

# Demo mode — simulates camera and generates seed patients
DEMO_MODE=true

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Frontend (copy to frontend/.env)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_DEMO_MODE=true
